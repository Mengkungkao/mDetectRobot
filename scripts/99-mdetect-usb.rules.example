# Optional examples only. The project defaults are fixed as requested:
#   /dev/ttyUSB0 = COIN-D6 LiDAR
#   /dev/ttyUSB1 = Arduino Uno
#
# Stable symlinks require unique USB serial numbers. Inspect each device with:
#   udevadm info -q property -n /dev/ttyUSB0
#   udevadm info -q property -n /dev/ttyUSB1
# Replace the placeholders before installing this file.
SUBSYSTEM=="tty", ENV{ID_SERIAL_SHORT}=="COIN_D6_SERIAL", GROUP="dialout", MODE="0660", SYMLINK+="coin_d6"
SUBSYSTEM=="tty", ENV{ID_SERIAL_SHORT}=="ARDUINO_SERIAL", GROUP="dialout", MODE="0660", SYMLINK+="arduino_mdetect"
