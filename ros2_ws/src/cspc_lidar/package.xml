  <maintainer email="meng@example.com">mDetect integration</maintainer>
  <license>LicenseRef-Vendor-SDK</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
