<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mdetect_robot">
  <xacro:property name="pi" value="3.141592653589793"/>
  <xacro:property name="body_length" value="0.310"/>
  <xacro:property name="body_width" value="0.210"/>
  <xacro:property name="body_height" value="0.100"/>
  <xacro:property name="wheel_radius" value="0.04025"/>
  <xacro:property name="wheel_width" value="0.028"/>
  <xacro:property name="wheel_x" value="0.105"/>
  <xacro:property name="wheel_y" value="0.095"/>
  <xacro:property name="wheel_z" value="0.04025"/>

  <material name="body_colour"><color rgba="0.18 0.30 0.52 1.0"/></material>
  <material name="wheel_colour"><color rgba="0.08 0.08 0.08 1.0"/></material>
  <material name="sensor_colour"><color rgba="0.15 0.15 0.15 1.0"/></material>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.065" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
      <material name="body_colour"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="4.0"/>
      <inertia ixx="0.018" ixy="0" ixz="0" iyy="0.035" iyz="0" izz="0.045"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="name x y">
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_colour"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.35"/>
        <inertia ixx="0.00025" ixy="0" ixz="0" iyy="0.00025" iyz="0" izz="0.00040"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} ${wheel_z - 0.065}" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
    </joint>
  </xacro:macro>

  <!-- Motor mapping: 1 and 4 are right; 2 and 3 are left. -->
  <xacro:wheel name="wheel_1" x="${wheel_x}" y="${-wheel_y}"/>
  <xacro:wheel name="wheel_2" x="${wheel_x}" y="${wheel_y}"/>
  <xacro:wheel name="wheel_3" x="${-wheel_x}" y="${wheel_y}"/>
  <xacro:wheel name="wheel_4" x="${-wheel_x}" y="${-wheel_y}"/>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.035" length="0.045"/></geometry>
      <material name="sensor_colour"/>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.115" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <visual>
      <geometry><box size="0.025 0.020 0.006"/></geometry>
      <material name="sensor_colour"/>
    </visual>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.028 0.010 0.045" rpy="0 0 0"/>
  </joint>
</robot>
